# Optional seed for local demos (inlined into the JS bundle — do not ship secrets).
# Prefer entering key / base URL / model in Skill Builder → API (AsyncStorage on-device).
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1

# Other OpenAI-compatible examples:
# EXPO_PUBLIC_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# EXPO_PUBLIC_OPENAI_MODEL=llama-3.3-70b-versatile
# EXPO_PUBLIC_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# EXPO_PUBLIC_OPENAI_BASE_URL=https://api.x.ai/v1
